{
  "crons": [
    { "path": "/health", "schedule": "*/5 * * * *" }
  ],
  "buildCommand": "bash scripts/download-free-db.sh && npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{data/database-free.db,node_modules/node-sqlite3-wasm/dist/node-sqlite3-wasm.wasm}"
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/version", "destination": "/api/health?version" }
  ]
}
